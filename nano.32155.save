version: '3.8'

services:
  managed-network-endpoint:
    image: nginx:latest
    container_name: cloudflare-managed-network
    ports:
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./example.pem:/etc/nginx/certs/cert.pem:ro
      - ./example.key:/etc/nginx/certs/key.key:ro
    restart: unless-stopped
    networks:
      - default
    healthcheck:
      test: ["CMD", "curl", "-f", "--cacert", "/etc/nginx/certs/cert.pem", "https://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

